generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String              @id @default(cuid())
  slug          String              @unique
  name          String
  description   String
  baseCategory  ProductBaseCategory
  printId       String?
  basePrice     Int
  images        String[]            @default([])
  popular       Boolean             @default(false)
  status        String              @default("active")
  createdAt     DateTime            @default(now())
  onSale        Boolean             @default(false)
  salePrice     Int?
  cutStyle      CutStyle?
  printCategory String?
  Print         Print?              @relation(fields: [printId], references: [id])
  variants      Variant[]
}

model Print {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  category    String?
  image       String
  gallery     String[]  @default([])
  description String
  showOnHome  Boolean   @default(false)
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  Product     Product[]
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  size      String
  fit       Fit
  colorName String
  colorHex  String
  price     Int
  stockQty  Int     @default(0)
  sku       String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Customer {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  patronymic String?
  phone      String    @unique
  email      String?
  createdAt  DateTime  @default(now())
  addresses  Address[]
  orders     Order[]
}

model Address {
  id             String   @id @default(cuid())
  customerId     String
  carrier        String   @default("nova-poshta")
  city           String
  postomatNumber String
  customer       Customer @relation(fields: [customerId], references: [id])
}

model Order {
  id            String          @id @default(cuid())
  orderNumber   String          @unique
  customerId    String
  status        OrderStatusCode @default(NEW)
  subtotal      Int
  deliveryCost  Int?
  total         Int
  contactMethod String
  comment       String?
  paymentStatus String          @default("pending")
  createdAt     DateTime        @default(now())
  customer      Customer        @relation(fields: [customerId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  variantId    String
  quantity     Int
  priceAtOrder Int
  order        Order  @relation(fields: [orderId], references: [id])
}

model CustomPrintRequest {
  id            String   @id @default(cuid())
  productId     String
  size          String
  colorName     String
  fileUrl       String
  text          String?
  comment       String?
  customerName  String
  customerPhone String
  customerEmail String
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

model PromoCode {
  id           String   @id @default(cuid())
  code         String   @unique
  discountType String
  value        Int
  validFrom    DateTime
  validTo      DateTime
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String
  provider   String
  status     String
  externalId String?
  createdAt  DateTime @default(now())
}

enum ProductBaseCategory {
  T_SHIRTS
  HOODIES
  BASICS
  SWEATSHIRTS
}

enum CutStyle {
  CLASSIC
  OVERSIZE
}

enum Fit {
  UNISEX
  WOMEN
}

enum OrderStatusCode {
  NEW
  CONFIRMED
  PAID
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PrintCategory {
  ANIME
  TEXT
  MEMES
  UKRAINIAN
  CARTOONS
  MOVIES
  MUSIC
  OTHER
}
