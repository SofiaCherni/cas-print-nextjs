# Admin panel password (single shared password — /admin/*, /api/admin/*).
# Pick any strong phrase; set the same value in Vercel → Environment Variables.
ADMIN_PASSWORD=""

# Database (Prisma + Postgres). Easiest free option: neon.tech or supabase.com —
# create a project there, copy the connection string here.
DATABASE_URL="postgresql://user:password@host:5432/casprint?sslmode=require"

# Email notifications via Resend (resend.com — free tier, no SMTP setup).
# 1. Create a Resend account, verify a sending domain (or use their test domain
#    while developing).
# 2. Create an API key -> RESEND_API_KEY.
# 3. ORDERS_FROM_EMAIL must be an address on the verified domain, e.g.
#    orders@cas-print.com.ua
# 4. ORDERS_NOTIFICATION_EMAIL is where new-order / new-custom-print alerts go
#    (the shop owner's inbox).
RESEND_API_KEY=""
ORDERS_FROM_EMAIL=""
ORDERS_NOTIFICATION_EMAIL=""

# File storage for custom-print uploads via Vercel Blob. On Vercel: Project ->
# Storage -> Create Database -> Blob. It injects BLOB_READ_WRITE_TOKEN
# automatically in production; for local dev, copy it here from the dashboard.
BLOB_READ_WRITE_TOKEN=""

# Payment provider — TODO: NEED REAL BUSINESS DATA (not wired up yet)
PAYMENT_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_WEBHOOK_SECRET=""

# Nova Poshta delivery API — TODO: NEED REAL BUSINESS DATA (not wired up yet)
NOVA_POSHTA_API_KEY=""

# --- SEO / аналітика (необов'язково: ці значення можна вписати й прямо у lib/site-config.ts) ---
# Домен сайту без "/" в кінці — для canonical, sitemap та Open Graph.
NEXT_PUBLIC_SITE_URL="https://your-domain.com.ua"
NEXT_PUBLIC_GA_ID=""                      # Google Analytics 4: G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=""              # Google Ads: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=""  # мітка конверсії «Покупка»
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=""      # мітка конверсії «Заявка на власний принт»
NEXT_PUBLIC_META_PIXEL_ID=""              # Meta Pixel ID
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""   # Google Search Console
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=""     # Meta Business: підтвердження домену
